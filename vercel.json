{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/cron/bot-test",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/discord-report",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/pilhado-premios-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sms-agendados",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/telegram-agendados",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/aquecimento",
      "schedule": "*/15 * * * *"
    }
  ]
}
